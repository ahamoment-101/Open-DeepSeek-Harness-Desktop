{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "Open-source desktop app wrapping DeepSeek Harness (dsh) — a Codex / Claude Code desktop counterpart",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "dev": "tsc && electron .",
    "dist": "tsc && electron-builder",
    "dist:mac": "tsc && electron-builder --mac"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "koffi",
      "@deepseek-ai/dsh-subprocess-local"
    ]
  }
}
