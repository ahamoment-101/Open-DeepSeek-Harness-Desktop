# macOS 签名 / 公证密钥 —— 只在 CI 的 secrets 里配置，绝不进 git。
# 复制本文件为 .env 仅供本地参考（.env 已被 .gitignore 排除）。

# 签名证书（electron-builder 通过 CSC_LINK / CSC_KEY_PASSWORD 读取）
# CSC_LINK=/path/to/DeveloperIDApplication.p12
# CSC_KEY_PASSWORD=your-p12-password

# 公证（notarytool + App Store Connect API Key，推荐）
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_API_KEY_ID=YOUR_KEY_ID
# APPLE_API_KEY_ISSUER=YOUR_ISSUER_ID
# APPLE_API_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# 或改用 Apple ID 公证（二选一，不推荐）
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
